---
import type { GetStaticPaths } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import { fetchPosts } from '~/utils/blog';
import { getFormattedDate } from '~/utils/utils';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await fetchPosts();

  const seriesMap = new Map<string, typeof posts>();
  for (const post of posts) {
    if (post.series) {
      if (!seriesMap.has(post.series)) {
        seriesMap.set(post.series, []);
      }
      seriesMap.get(post.series)!.push(post);
    }
  }

  return Array.from(seriesMap.entries()).map(([seriesSlug, seriesPosts]) => ({
    params: { slug: seriesSlug },
    props: {
      seriesSlug,
      posts: seriesPosts.sort((a, b) => (a.seriesOrder || 0) - (b.seriesOrder || 0)),
    },
  }));
}) satisfies GetStaticPaths;

const { seriesSlug, posts } = Astro.props;

const seriesTitle = seriesSlug
  .split('-')
  .map((word: string) => (word.length <= 2 ? word.toUpperCase() : word.charAt(0).toUpperCase() + word.slice(1)))
  .join(' ');

const ogImageUrl = new URL(`/og/series/${seriesSlug}.png`, Astro.site).toString();

const metadata = {
  title: seriesTitle,
  description: `All posts in the ${seriesTitle} series.`,
  robots: { index: true, follow: true },
  openGraph: {
    type: 'website',
    images: [{ url: ogImageUrl, width: 1200, height: 630 }],
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">
        {seriesTitle}
      </h1>
      <p class="mt-2 text-lg text-muted dark:text-slate-400">
        {posts.length} post{posts.length !== 1 ? 's' : ''} published
      </p>
    </div>

    <ol class="space-y-4">
      {posts.map((post) => (
        <li class="flex gap-4 items-start p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:border-primary/50 dark:hover:border-blue-400/50 transition-colors">
          <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center rounded-full bg-primary/10 dark:bg-blue-400/10 text-primary dark:text-blue-400 font-bold text-sm">
            {post.seriesOrder}
          </span>
          <div class="min-w-0 flex-1">
            <a
              href={`/${post.permalink}`}
              class="text-lg font-semibold hover:text-primary dark:hover:text-blue-400 transition-colors"
            >
              {post.title}
            </a>
            <div class="flex items-center gap-3 mt-1 text-sm text-muted dark:text-slate-400">
              <time datetime={String(post.publishDate)}>
                {getFormattedDate(post.publishDate)}
              </time>
              {post.readingTime && <span>{post.readingTime} min read</span>}
            </div>
            {post.excerpt && (
              <p class="mt-1 text-sm text-muted dark:text-slate-400 line-clamp-2">
                {post.excerpt}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>
</Layout>
