---
/**
 * Synthetic Data Pipeline diagram — static HTML/CSS/Tailwind.
 * Vertical layout matching the README's Mermaid flowchart structure.
 *
 * Flow: Templates → Generator → Validator → Evaluator → Analysis → Corrector
 * Feedback: Corrector → Templates (improved templates)
 *           Corrector → Evaluator (fixed records)
 */
---

<div class="not-prose my-8 mx-auto max-w-lg font-sans text-sm">
  <div class="flex flex-col items-center">
    <!-- Templates v1 & v2 — feedback target ① -->
    <div
      class="flex items-center gap-3 rounded-lg border-2 border-indigo-400 dark:border-indigo-500 bg-indigo-50 dark:bg-indigo-950 px-5 py-2.5"
    >
      <span
        class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-white font-bold"
        style="font-size:10px">1</span
      >
      <div class="text-center">
        <span class="font-semibold text-indigo-900 dark:text-indigo-100">Templates</span>
        <span class="ml-2 text-xs text-indigo-600 dark:text-indigo-400">v1 & v2</span>
      </div>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Generator -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Generator</span>
      <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">GPT-4o-mini + Instructor</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Validator -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Validator</span>
      <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">Pydantic</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Evaluator — feedback target ② -->
    <div
      class="flex items-center gap-3 rounded-lg border-2 border-indigo-400 dark:border-indigo-500 bg-indigo-50 dark:bg-indigo-950 px-5 py-2.5"
    >
      <span
        class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-white font-bold"
        style="font-size:10px">2</span
      >
      <div class="text-center">
        <span class="font-semibold text-indigo-900 dark:text-indigo-100">Evaluator</span>
        <span class="ml-2 text-xs text-indigo-600 dark:text-indigo-400">GPT-4o Judge</span>
      </div>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Analysis -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Analysis</span>
      <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">Pandas + Seaborn</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">
      ↓ <span class="text-xs">failure patterns</span>
    </div>

    <!-- Corrector — feedback source → ① and ② -->
    <div
      class="flex items-center justify-between rounded-lg border-2 border-orange-400 dark:border-orange-500 bg-orange-50 dark:bg-orange-950 px-5 py-2.5 w-full max-w-xs"
    >
      <span class="font-semibold text-orange-900 dark:text-orange-100">Corrector</span>
      <div class="flex items-center gap-1.5 text-orange-600 dark:text-orange-400">
        <span class="text-xs font-medium">feeds back to</span>
        <span
          class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-orange-500 text-white font-bold"
          style="font-size:10px">1</span
        >
        <span
          class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-orange-500 text-white font-bold"
          style="font-size:10px">2</span
        >
      </div>
    </div>
  </div>

  <!-- Feedback loop legend -->
  <div
    class="mt-3 rounded-lg border border-dashed border-orange-300 dark:border-orange-700 bg-orange-50/60 dark:bg-orange-950/60 px-4 py-3 space-y-2"
  >
    <p class="text-orange-700 dark:text-orange-400 font-bold uppercase tracking-wide" style="font-size:11px">
      ↺ Feedback Loop
    </p>

    <div class="flex items-center gap-2 text-xs">
      <span
        class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-white font-bold"
        style="font-size:10px">1</span
      >
      <span class="text-slate-700 dark:text-slate-300">Corrector → Templates</span>
      <span
        class="ml-auto rounded bg-orange-200 dark:bg-orange-800/70 px-2 py-0.5 font-medium text-orange-800 dark:text-orange-200"
        style="font-size:11px">improved templates</span
      >
    </div>

    <div class="flex items-center gap-2 text-xs">
      <span
        class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-white font-bold"
        style="font-size:10px">2</span
      >
      <span class="text-slate-700 dark:text-slate-300">Corrector → Evaluator</span>
      <span
        class="ml-auto rounded bg-orange-200 dark:bg-orange-800/70 px-2 py-0.5 font-medium text-orange-800 dark:text-orange-200"
        style="font-size:11px">fixed records</span
      >
    </div>
  </div>
</div>
