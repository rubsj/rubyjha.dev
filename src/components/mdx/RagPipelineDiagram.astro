---
/**
 * RAG Evaluation Pipeline diagram — static HTML/CSS/Tailwind.
 * Matches the Mermaid diagram from the project README but rendered as
 * hand-crafted HTML to avoid headless dagre layout issues (overlapping
 * nodes when branches fan out).
 *
 * Structure mirrors: graph TB from README
 *   3 Markdown Documents → Parser → Chunking → Embedding + BM25 (side-by-side)
 *   → FAISS + BM25 both feed 56 QA pairs → 5 eval layers
 *   → 3 outputs spread horizontally
 */
---

<div class="not-prose my-8 mx-auto max-w-lg font-sans text-sm">
  <div class="flex flex-col items-center">
    <!-- 3 Markdown Documents -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">3 Markdown Documents</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Parser -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Parser</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Chunking: 5 strategies -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Chunking: 5 strategies</span>
    </div>

    <!-- Split into two branches -->
    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Embedding: 3 models -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Embedding: 3 models</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- FAISS IndexFlatIP + BM25 Baseline side-by-side -->
    <div class="grid grid-cols-2 gap-4 w-full">
      <div
        class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-center"
      >
        <span class="font-semibold text-slate-800 dark:text-slate-100">FAISS IndexFlatIP</span>
      </div>
      <div
        class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-4 py-2.5 text-center"
      >
        <span class="font-semibold text-slate-800 dark:text-slate-100">BM25 Baseline</span>
      </div>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- 56 Synthetic QA pairs -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">56 Synthetic QA pairs</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Layer 1: Retrieval Metrics -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Layer 1: Retrieval Metrics</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Layer 2: BM25 Comparison -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Layer 2: BM25 Comparison</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Layer 3: Cohere Reranking -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Layer 3: Cohere Reranking</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Layer 4: RAGAS Generation Quality -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Layer 4: RAGAS Generation Quality</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Layer 5: LLM Judge -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Layer 5: LLM Judge</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- 3 outputs spread horizontally -->
    <div class="grid grid-cols-3 gap-3 w-full">
      <div
        class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-center"
      >
        <span class="font-semibold text-slate-800 dark:text-slate-100 text-xs">Braintrust Experiments</span>
      </div>
      <div
        class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-center"
      >
        <span class="font-semibold text-slate-800 dark:text-slate-100 text-xs">12 Visualizations</span>
      </div>
      <div
        class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-center"
      >
        <span class="font-semibold text-slate-800 dark:text-slate-100 text-xs">GridSearchReport.json</span>
      </div>
    </div>
  </div>
</div>
