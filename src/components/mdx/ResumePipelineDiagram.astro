---
/**
 * AI Resume Coach pipeline diagram — static HTML/CSS/Tailwind.
 * Vertical layout matching the README's Mermaid graph TD structure.
 *
 * Flow: run_generation.py → run_labeling.py → judge.py → corrector.py
 *       → analyzer.py → multi_hop.py → vector_store.py → api.py
 *       → streamlit_app.py
 */
---

<div class="not-prose my-8 mx-auto max-w-lg font-sans text-sm">
  <div class="flex flex-col items-center">
    <!-- run_generation.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">run_generation.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">50 jobs × 5 fit levels</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">= 250 resumes</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- run_labeling.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">run_labeling.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">5 failure mode flags</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">Jaccard similarity</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- judge.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">judge.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">GPT-4o evaluation</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">quality score 0-1</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- corrector.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">corrector.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">Instructor retry loop</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">8/8 corrected</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- analyzer.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">analyzer.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">9 charts</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">pipeline_summary.json</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- multi_hop.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">multi_hop.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">4 reasoning questions</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">per pair</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- vector_store.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">vector_store.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">ChromaDB</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">all-MiniLM-L6-v2</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- api.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">api.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">FastAPI</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">9 endpoints</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- streamlit_app.py -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">streamlit_app.py</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">5-page demo</span>
    </div>
  </div>
</div>
