---
/**
 * Contrastive Embedding Fine-Tuning architecture diagram — static HTML/CSS/Tailwind.
 * Vertical layout matching the README's Mermaid flowchart TD structure.
 *
 * Flow: Training/Eval Pairs → Data Loader → Training Mode (decision)
 *       → Standard | LoRA → Generate Embeddings → 8-Metric Evaluation
 *       → Comparison Report
 */
---

<div class="not-prose my-8 mx-auto max-w-lg font-sans text-sm">
  <div class="flex flex-col items-center">
    <!-- 1,475 Training Pairs / 295 Eval Pairs -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">1,475 Training Pairs</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">295 Eval Pairs</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Data Loader -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Data Loader</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Training Mode (decision diamond) -->
    <div
      class="rotate-45 border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 w-24 h-24 flex items-center justify-center"
    >
      <span class="-rotate-45 font-semibold text-slate-800 dark:text-slate-100 text-xs text-center leading-tight"
        >Training<br />Mode</span
      >
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Standard vs LoRA side-by-side -->
    <div class="grid grid-cols-2 gap-4 w-full">
      <div class="text-center">
        <span class="text-xs text-slate-400 dark:text-slate-500 mb-1 block">Standard</span>
        <div class="rounded-lg bg-blue-600 px-3 py-2.5 text-center">
          <span class="font-semibold text-white text-xs">Full Fine-Tuning</span>
          <br />
          <span class="text-xs text-blue-100">22.7M params</span>
          <br />
          <span class="text-xs text-blue-100">CosineSimilarityLoss</span>
        </div>
      </div>
      <div class="text-center">
        <span class="text-xs text-slate-400 dark:text-slate-500 mb-1 block">LoRA</span>
        <div class="rounded-lg bg-orange-500 px-3 py-2.5 text-center">
          <span class="font-semibold text-white text-xs">LoRA Adapters</span>
          <br />
          <span class="text-xs text-orange-100">73K params, r=8</span>
          <br />
          <span class="text-xs text-orange-100">10x learning rate</span>
        </div>
      </div>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Generate Embeddings -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Generate Embeddings</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">del model + gc.collect</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- 8-Metric Evaluation -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">8-Metric Evaluation</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">Spearman, Margin, AUC-ROC</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">Cohen's d, F1, Clustering</span>
    </div>

    <div class="py-1 text-base leading-none text-slate-400 dark:text-slate-500">↓</div>

    <!-- Comparison Report -->
    <div
      class="rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 px-5 py-2.5 text-center"
    >
      <span class="font-semibold text-slate-800 dark:text-slate-100">Comparison Report</span>
      <br />
      <span class="text-xs text-slate-500 dark:text-slate-400">8 Charts + HTML + FP Analysis</span>
    </div>
  </div>
</div>
